from textblob import TextBlob

# Step 1: Define a function to classify sentiment
def classify_sentiment(comment):
    """
    Classifies a given comment as Positive, Negative, or Neutral based on polarity.
    """
    analysis = TextBlob(comment)  # Analyze the comment's sentiment
    if analysis.sentiment.polarity > 0:  # Positive sentiment
        return "Positive"
    elif analysis.sentiment.polarity < 0:  # Negative sentiment
        return "Negative"
    else:  # Neutral sentiment
        return "Neutral"

# Step 2: Create a list of comments to analyze
