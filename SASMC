    "I love this post, it’s amazing!",
    "This is a terrible post, I don't like it.",
    "It's okay, nothing special.",
    "Absolutely fantastic! Highly recommend.",
    "Not my cup of tea, but others might like it."
]

# Step 3: Analyze each comment and print the result
for comment in comments:
    sentiment = classify_sentiment(comment)  # Classify the comment's sentiment
    print(f"Comment: \"{comment}\" \nSentiment: {sentiment}\n")

