def fetch_comments(query, count=10):
    """
    Fetches the latest tweets based on a search query.
    Parameters:
    - query: The keyword or hashtag to search for.
    - count: Number of tweets to fetch.
    Returns:
    - A list of tweet texts.
    """
    tweets = api.search_tweets(q=query, count=count, lang="en")
    return [tweet.text for tweet in tweets]

# Step 4: Define a function to classify sentiment
